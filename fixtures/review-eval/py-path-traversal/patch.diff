--- /dev/null
+++ b/app/files.py
@@ -0,0 +1,9 @@
+import os
+
+UPLOAD_DIR = "/srv/shop/uploads"
+
+
+def read_upload(name):
+    path = os.path.join(UPLOAD_DIR, name)
+    with open(path, "rb") as handle:
+        return handle.read()
