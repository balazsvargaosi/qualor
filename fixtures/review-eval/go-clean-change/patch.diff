diff --git a/batch/chunk.go b/batch/chunk.go
new file mode 100644
--- /dev/null
+++ b/batch/chunk.go
@@ -0,0 +1,16 @@
+package batch
+
+// Chunk splits items into consecutive slices of at most size elements. The slices share items'
+// memory, and appending to one never overwrites the next. It panics if size is not positive.
+func Chunk[T any](items []T, size int) [][]T {
+	if size <= 0 {
+		panic("batch.Chunk: size must be positive")
+	}
+	var chunks [][]T
+	for len(items) > 0 {
+		n := min(size, len(items))
+		chunks = append(chunks, items[:n:n])
+		items = items[n:]
+	}
+	return chunks
+}
diff --git a/batch/chunk_test.go b/batch/chunk_test.go
new file mode 100644
--- /dev/null
+++ b/batch/chunk_test.go
@@ -0,0 +1,44 @@
+package batch
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestChunk(t *testing.T) {
+	tests := []struct {
+		name  string
+		items []int
+		size  int
+		want  [][]int
+	}{
+		{"empty", nil, 3, nil},
+		{"fewer than one chunk", []int{1, 2}, 3, [][]int{{1, 2}}},
+		{"exactly one chunk", []int{1, 2, 3}, 3, [][]int{{1, 2, 3}}},
+		{"a short last chunk", []int{1, 2, 3, 4, 5}, 2, [][]int{{1, 2}, {3, 4}, {5}}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := Chunk(tc.items, tc.size); !reflect.DeepEqual(got, tc.want) {
+				t.Errorf("got %v, want %v", got, tc.want)
+			}
+		})
+	}
+}
+
+func TestChunkPanicsOnASizeThatIsNotPositive(t *testing.T) {
+	defer func() {
+		if recover() == nil {
+			t.Error("expected a panic")
+		}
+	}()
+	Chunk([]int{1}, 0)
+}
+
+func TestChunkAppendDoesNotOverwriteTheNextChunk(t *testing.T) {
+	chunks := Chunk([]int{1, 2, 3, 4}, 2)
+	_ = append(chunks[0], 99)
+	if chunks[1][0] != 3 {
+		t.Errorf("the next chunk was overwritten: %v", chunks[1])
+	}
+}
